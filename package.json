{
  "name": "ani-cli-gui",
  "version": "0.1.0",
  "description": "Desktop and web app for ani-cli style streaming: sources, library with watch progress, built-in player, mpv, downloads",
  "main": "src/main/main.js",
  "license": "GPL-3.0-only",
  "scripts": {
    "start": "electron .",
    "serve": "node src/server/cli.js",
    "build:web": "node scripts/build_web.js",
    "postinstall": "node scripts/copy_vendor.js",
    "test": "node --test \"test/*_test.js\"",
    "test:live": "node --test \"test/live/*_test.js\"",
    "build": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "hls.js": "^1.7.3"
  },
  "author": "zy",
  "build": {
    "appId": "com.zy.ani-cli-gui",
    "productName": "ani-cli GUI",
    "files": [
      "src/**/*",
      "scrapers/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable"
    }
  }
}
